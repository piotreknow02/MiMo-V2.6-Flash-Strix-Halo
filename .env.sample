# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults

# Image tag and container name.
#IMAGE=mimo26-flash-strix:latest
#CONTAINER_NAME=mimo26-flash-strix

# Host publish port (container always listens on 8000 internally).
#PORT=8080

# Where the ~107 GB checkpoint lives / gets downloaded to.
#MODEL_DIR=./models

# Kyojin/HIP/HF caches (persists kernel/GEMM autotune across restarts).
#CACHE_DIR=./.cache

# HuggingFace model and revision.
#HF_MODEL=yamz-labs/MiMo-V2.6-Flash-MOPD-EXL3-Yamz
#HF_REVISION=                                  # empty = latest; pin a commit for reproducibility

# Log file for the engine output stream.
#LOG_FILE=./.mimo26.log

# Kernel build parallelism (hipcc/ninja + podman build --jobs).
# Unset/empty = auto-detect via nproc (host core count).
#MAX_JOBS=

# Ready timeout (seconds). The first launch can take several minutes while
# the engine compiles dense GEMM kernels and loads the model.
#READY_TIMEOUT=3600

# Optional: skip the vision tower (saves 1.4 GiB GPU memory; image requests get HTTP 400).
# Any non-empty value (e.g. NO_VISION=1) passes --no-vision to the server.
#NO_VISION=

# Context window in tokens. 262144 (256K) is the documented default and needs
# ~105 GiB of unified memory with the vision tower. Lower it (e.g. 32768 or
# 65536) when other apps are using RAM. Takes effect on the next start; the
# model does not need to be downloaded again.
#CTX_SIZE=262144

# Optional: HuggingFace token for higher download rate limits.
# `hf` picks it up from env automatically; start.sh passes it through.
#HF_TOKEN=
